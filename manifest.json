{
  "manifest_version": 3,
  "name": "ComboBreaker",
  "short_name": "ComboBreaker",
  "version": "0.8.2",
  "description": "One privacy-respecting toolbox instead of a dozen small extensions: per-site JS/CSS, dark mode, dev tools, downloader. No telemetry.",
  "author": "scootsmagoo",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ComboBreaker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "windows",
    "scripting",
    "contentSettings",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "downloads",
    "cookies",
    "webRequest",
    "nativeMessaging",
    "notifications",
    "userScripts",
    "browsingData"
  ],
  "optional_permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "js": [
        "content/site_injector.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_end",
      "all_frames": false,
      "js": [
        "content/json_formatter.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "content/media_finder.js"
      ]
    },
    {
      "matches": [
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://x.com/*",
        "*://*.x.com/*"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "js": [
        "content/page_hooks.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false,
      "js": [
        "content/media_overlay.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "tools/color_picker.js",
        "tools/ruler.js",
        "tools/whatfont.js",
        "vendor/darkreader.js",
        "viewer/hls_downloader.html",
        "viewer/hls_downloader.css",
        "viewer/hls_downloader.js",
        "viewer/reader.html",
        "viewer/reader.css",
        "viewer/reader.js",
        "viewer/structured_data.html",
        "viewer/structured_data.css",
        "viewer/structured_data.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "combobreaker_basic_block",
        "enabled": true,
        "path": "rules/basic_block.json"
      },
      {
        "id": "combobreaker_strong_block",
        "enabled": false,
        "path": "rules/strong_block.json"
      }
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Open ComboBreaker popup"
    },
    "toggle-darkmode": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Toggle dark mode for the current site"
    },
    "toggle-js": {
      "description": "Toggle JavaScript for the current site"
    },
    "nuke-site-data": {
      "description": "Nuke all site data for the current site (no shortcut until you set one)"
    },
    "pick-color": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Pick a color from the page"
    }
  }
}
